{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "eu4mod",
      "camelcase": "eu4mod",
      "title": "EU4 Modding",
      "scope": "source.eu4mod",
      "file-types": [
        "txt",
        "gui",
        "yml",
        "gfx"
      ],
      "injection-regex": "^eu4mod$",
      "class-name": "TreeSitterEu4mod"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for EU4 modding, covering txt, yml, gfx, and gui files",
    "authors": [
      {
        "name": "Dylan",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-eu4mod",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}