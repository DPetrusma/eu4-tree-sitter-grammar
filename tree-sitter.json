{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "eu4script",
      "camelcase": "Eu4script",
      "title": "EU4 Script",
      "scope": "source.eu4script",
      "path": ".",
      "file-types": ["gui"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Minimal tree-sitter grammar for Paradox / EU4 script",
    "authors": [{ "name": "YOUR NAME" }],
    "links": { "repository": "https://github.com/YOUR_USER/tree-sitter-eu4script" }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
